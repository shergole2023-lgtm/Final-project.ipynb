              f'True: {true_class}\n'
              f'Predicted: {predicted_class}\n'
              f'Confidence: {predicted_prob:.2f}', 
              fontsize=12)
    plt.axis('off')
    plt.tight_layout()
    plt.show()
    
    print(f"True label: {true_class}")
    print(f"Predicted: {predicted_class} (confidence: {predicted_prob:.2f})")
else:
    print(f"Index {index_to_plot} out of range. Available images: {len(test_images)}")
print()


