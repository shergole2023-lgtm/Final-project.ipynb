# %% [markdown]
# # Final Project - Image Classification

# %% [markdown]
# ## Import Libraries

# %%
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
from tensorflow.keras.preprocessing.image import ImageDataGenerator
import numpy as np
import matplotlib.pyplot as plt
import os

print("Libraries imported successfully")

# %% [markdown]
# ## Task 1: Print the version of TensorFlow

# %%
print("TensorFlow version:", tf.__version__)

# %% [markdown]
# ## Load and Prepare Data

# %%
# Load CIFAR-10 dataset
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.cifar10.load_data()

# Normalize pixel values
x_train = x_train.astype('float32') / 255.0
x_test = x_test.astype('float32') / 255.0

# Convert labels to categorical
y_train = tf.keras.utils.to_categorical(y_train, num_classes=10)
y_test = tf.keras.utils.to_categorical(y_test, num_classes=10)

print(f"Training data shape: {x_train.shape}")
print(f"Testing data shape: {x_test.shape}")

# %% [markdown]
# ## Create Data Generators

# %%
batch_size = 32

# Create data generators
train_generator = tf.data.Dataset.from_tensor_slices((x_train, y_train))
train_generator = train_generator.shuffle(1000).batch(batch_size)

# Task 2: Create a test_generator using the test_datagen object
test_datagen = tf.keras.preprocessing.image.ImageDataGenerator(rescale=1./255)
test_generator = tf.data.Dataset.from_tensor_slices((x_test, y_test))
test_generator = test_generator.batch(batch_size)

print("Test generator created successfully")

# %% [markdown]
# ## Task 3: Print the length of the train_generator

# %%
train_length = len(list(train_generator))
print("Length of train_generator:", train_length)

# %% [markdown]
# ## Create Extract Features Model

# %%
def create_extract_feat_model():
    model = keras.Sequential([
        layers.Conv2D(32, (3, 3), activation='relu', input_shape=(32, 32, 3)),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(64, (3, 3), activation='relu'),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(64, (3, 3), activation='relu'),
        layers.Flatten(),
        layers.Dense(64, activation='relu'),
        layers.Dense(10, activation='softmax')
    ])
    return model

model_extract = create_extract_feat_model()

# %% [markdown]
# ## Task 4: Print the summary of the model

# %%
print("Extract Features Model Summary:")
model_extract.summary()

# %% [markdown]
# ## Task 5: Compile the model

# %%
model_extract.compile(
    optimizer='adam',
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

print("Model compiled successfully")

# %% [markdown]
# ## Train Extract Features Model

# %%
print("Training Extract Features Model...")
history_extract = model_extract.fit(
    train_generator,
    epochs=10,
    validation_data=test_generator,
    verbose=1
)

# %% [markdown]
# ## Task 6: Plot accuracy curves for training and validation sets (extract_feat_model)

# %%
plt.figure(figsize=(10, 6))
plt.plot(history_extract.history['accuracy'], label='Training Accuracy', linewidth=2)
plt.plot(history_extract.history['val_accuracy'], label='Validation Accuracy', linewidth=2)
plt.title('Extract Features Model - Accuracy Curves', fontsize=16)
plt.xlabel('Epochs', fontsize=12)
plt.ylabel('Accuracy', fontsize=12)
plt.legend(fontsize=12)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# %% [markdown]
# ## Create Fine-Tuned Model

# %%
def create_finetune_model():
    model = keras.Sequential([
        layers.Conv2D(32, (3, 3), activation='relu', input_shape=(32, 32, 3)),
        layers.BatchNormalization(),
        layers.MaxPooling2D((2, 2)),
        
        layers.Conv2D(64, (3, 3), activation='relu'),
        layers.BatchNormalization(),
        layers.MaxPooling2D((2, 2)),
        
        layers.Conv2D(128, (3, 3), activation='relu'),
        layers.BatchNormalization(),
        layers.MaxPooling2D((2, 2)),
        
        layers.Conv2D(256, (3, 3), activation='relu'),
        layers.BatchNormalization(),
        layers.GlobalAveragePooling2D(),
        
        layers.Dense(256, activation='relu'),
        layers.Dropout(0.5),
        layers.Dense(128, activation='relu'),
        layers.Dropout(0.3),
        layers.Dense(10, activation='softmax')
    ])
    return model

model_finetune = create_finetune_model()

model_finetune.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.0001),
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

print("Fine-Tuned Model created and compiled")

# %% [markdown]
# ## Train Fine-Tuned Model

# %%
print("Training Fine-Tuned Model...")
history_finetune = model_finetune.fit(
    train_generator,
    epochs=15,
    validation_data=test_generator,
    verbose=1
)

# %% [markdown]
# ## Task 7: Plot loss curves for training and validation sets (fine tune model)

# %%
plt.figure(figsize=(10, 6))
plt.plot(history_finetune.history['loss'], label='Training Loss', linewidth=2)
plt.plot(history_finetune.history['val_loss'], label='Validation Loss', linewidth=2)
plt.title('Fine-Tuned Model - Loss Curves', fontsize=16)
plt.xlabel('Epochs', fontsize=12)
plt.ylabel('Loss', fontsize=12)
plt.legend(fontsize=12)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# %% [markdown]
# ## Task 8: Plot accuracy curves for training and validation sets (fine tune model)

# %%
plt.figure(figsize=(10, 6))
plt.plot(history_finetune.history['accuracy'], label='Training Accuracy', linewidth=2)
plt.plot(history_finetune.history['val_accuracy'], label='Validation Accuracy', linewidth=2)
plt.title('Fine-Tuned Model - Accuracy Curves', fontsize=16)
plt.xlabel('Epochs', fontsize=12)
plt.ylabel('Accuracy', fontsize=12)
plt.legend(fontsize=12)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# %% [markdown]
# ## Task 9: Plot a test image using Extract Features Model (index_to_plot = 1)

# %%
# Get a batch of test images
for images, labels in test_generator.take(1):
    # Get image at index 1
    img = images[1].numpy()
    true_label = np.argmax(labels[1].numpy())
    
    # Get prediction
    prediction = model_extract.predict(np.expand_dims(images[1], axis=0))
    pred_label = np.argmax(prediction)
    confidence = np.max(prediction) * 100
    
    # Plot
    plt.figure(figsize=(8, 6))
    plt.imshow(img)
    plt.axis('off')
    plt.title(f"Extract Features Model\nTrue: {true_label}, Predicted: {pred_label}\nConfidence: {confidence:.2f}%", 
              fontsize=14, pad=20)
    plt.tight_layout()
    plt.show()
    
    print(f"True label: {true_label}")
    print(f"Predicted label: {pred_label}")
    print(f"Confidence: {confidence:.2f}%")
    break

# %% [markdown]
# ## Task 10: Plot a test image using Fine-Tuned Model (index_to_plot = 1)

# %%
# Get a batch of test images
for images, labels in test_generator.take(1):
    # Get image at index 1
    img = images[1].numpy()
    true_label = np.argmax(labels[1].numpy())
    
    # Get prediction
    prediction = model_finetune.predict(np.expand_dims(images[1], axis=0))
    pred_label = np.argmax(prediction)
    confidence = np.max(prediction) * 100
    
    # Plot
    plt.figure(figsize=(8, 6))
    plt.imshow(img)
    plt.axis('off')
    plt.title(f"Fine-Tuned Model\nTrue: {true_label}, Predicted: {pred_label}\nConfidence: {confidence:.2f}%", 
              fontsize=14, pad=20)
    plt.tight_layout()
    plt.show()
    
    print(f"True label: {true_label}")
    print(f"Predicted label: {pred_label}")
    print(f"Confidence: {confidence:.2f}%")
    break

# %% [markdown]
# ## Model Comparison

# %%
print("=" * 50)
print("MODEL COMPARISON")
print("=" * 50)

extract_acc = history_extract.history['val_accuracy'][-1]
finetune_acc = history_finetune.history['val_accuracy'][-1]

print(f"Extract Features Model - Final Validation Accuracy: {extract_acc:.4f}")
print(f"Fine-Tuned Model - Final Validation Accuracy: {finetune_acc:.4f}")

plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.plot(history_extract.history['val_accuracy'], label='Extract Features', linewidth=2)
plt.plot(history_finetune.history['val_accuracy'], label='Fine-Tuned', linewidth=2)
plt.title('Validation Accuracy Comparison', fontsize=14)
plt.xlabel('Epochs')
plt.ylabel('Accuracy')
plt.legend()
plt.grid(True, alpha=0.3)

plt.subplot(1, 2, 2)
plt.plot(history_extract.history['val_loss'], label='Extract Features', linewidth=2)
plt.plot(history_finetune.history['val_loss'], label='Fine-Tuned', linewidth=2)
plt.title('Validation Loss Comparison', fontsize=14)
plt.xlabel('Epochs')
plt.ylabel('Loss')
plt.legend()
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

print("\n✅ All 10 tasks completed successfully!")
print("✅ TensorFlow version printed")
print("✅ Test generator created")
print("✅ Train generator length printed")
print("✅ Model summary printed")
print("✅ Model compiled")
print("✅ Extract features model accuracy curves plotted")
print("✅ Fine-tuned model loss curves plotted")
print("✅ Fine-tuned model accuracy curves plotted")
print("✅ Test image plotted with extract features model")
print("✅ Test image plotted with fine-tuned model")
